{
  "expo": {
    "name": "WashAlertMobile",
    "slug": "WashAlertMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "washalertmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.washalert.mobile",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCTf8ghwEOdt9d4UaIk-h4my02vn71h67s"
        }
      },
      "edgeToEdgeEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.washalert.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyAzAGBAijqpEZki3ZZBYe-9rxtzjF55RSY"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow WashAlert to track your location for real-time delivery updates.",
        "NSLocationWhenInUseUsageDescription": "Allow WashAlert to track your location for real-time delivery updates."
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A2B4A",
          "dark": {
            "backgroundColor": "#1A2B4A"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow WashAlert to track your location for real-time delivery updates."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1d4ed8",
          "defaultChannel": "washalert-updates"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/df1ad6db-6140-4874-9536-8899437e9838",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "df1ad6db-6140-4874-9536-8899437e9838"
      }
    },
    "owner": "princeeee_12",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
