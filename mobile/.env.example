# WashAlert mobile backend (Android emulator default)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8081

# Firebase Web API key used by Firebase REST Identity Toolkit requests
EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=washalert-b8ce8.firebasestorage.app
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=washalert-b8ce8.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=washalert-b8ce8
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY

# Keep demo mode disabled for real backend verification builds
EXPO_PUBLIC_ENABLE_DEMO_MODE=false
