## =========================
## WashAlert Backend Env Template
## =========================

# --- Shared Railway MySQL (required) ---
DB_URL=jdbc:mysql://YOUR_HOST:YOUR_PORT/YOUR_DATABASE?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD

# --- Optional app settings ---
SERVER_PORT=8081
FRONTEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
SESSION_COOKIE_SAME_SITE=none
SESSION_COOKIE_SECURE=true

# JPA schema mode (default in app.yaml is update if omitted).
# Recommended for stable Railway production: validate (or none if schema is externally managed).
JPA_DDL_AUTO=update

# --- Optional admin bootstrap (disabled by default) ---
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@washalert.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeThis_123
ADMIN_BOOTSTRAP_FULL_NAME=System Administrator
ADMIN_BOOTSTRAP_BRANCH=Makati Branch

# --- Optional mail settings ---
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=<resend_api_key>
MAIL_FROM=WashAlert Support <noreply@washalert.com>

# --- Optional Firebase backend settings ---
# Set true to enable Firebase Admin features including FCM push notifications.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_PATH=C:/path/to/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Optional Gemini AI-support settings (server-side only) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional fallback if GEMINI_API_KEY is not set.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Optional override for compatible Gemini gateway base URL.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Optional PayMongo settings (required for GCash checkout) ---
PAYMONGO_SECRET_KEY=sk_test_xxx_or_sk_live_xxx
PAYMONGO_PUBLIC_KEY=pk_test_xxx_or_pk_live_xxx
# Optional: for webhook signature verification if enabled.
PAYMONGO_WEBHOOK_SECRET=

# --- Optional URLs ---
PASSWORD_RESET_FRONTEND_BASE_URL=http://localhost:8080
STAFF_INVITATION_FRONTEND_BASE_URL=http://localhost:8080
STAFF_INVITATION_SET_PASSWORD_PATH=/set-password

# --- Data mode ---
DATA_READ_MODE=MYSQL
