## =========================
## WashAlert Backend Env Template
## =========================

# --- Shared Railway MySQL (required) ---
DB_URL=jdbc:mysql://YOUR_HOST:YOUR_PORT/YOUR_DATABASE?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD

# --- Optional app settings ---
SERVER_PORT=8081
FRONTEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# --- Optional mail settings ---
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM=WashAlert Support <noreply@YOUR_VERIFIED_DOMAIN>

# --- Optional Firebase backend settings ---
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_PATH=C:/path/to/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Optional URLs ---
PASSWORD_RESET_FRONTEND_BASE_URL=http://localhost:8080
STAFF_INVITATION_FRONTEND_BASE_URL=http://localhost:8080
STAFF_INVITATION_SET_PASSWORD_PATH=/set-password

# --- Data mode ---
DATA_READ_MODE=MYSQL
